# Copia este archivo a .env.local y pon tu key real.
MASSIVE_API_KEY=tu_api_key_de_massive
MASSIVE_MAX_PAGES=40

# Cookie de sesión de app.marketsnack.com (para el sub-agente Time & Sales).
# DevTools → Network → request a /api/flow_feed → copia el header "Cookie" completo.
MARKETSNACK_COOKIE=

# Webhook de Discord para las alertas del piloto automático (opcional).
# Discord → Configuración del canal → Integraciones → Webhooks → Nuevo Webhook → Copiar URL.
DISCORD_WEBHOOK_URL=

# Secreto compartido para POST /api/autopilot/scan (solo necesario si despliegas
# la app públicamente, ej. Vercel). Sin esto, cualquiera con la URL podría disparar
# escaneos. Genera algo random (ej. `openssl rand -hex 32`) y usa el mismo valor
# aquí y en el header x-cron-secret de quien dispare el escaneo (GitHub Actions, etc.).
CRON_SECRET=
